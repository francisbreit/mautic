{% extends '@MauticCore/FormTheme/form_simple.html.twig' %}
{% form_theme form with [
    '@MauticSms/FormTheme/SmsSendList/smssend_list_row.html.twig'
] %}

{% block mauticContent %}sms{% endblock %}
{# @var sms \Mautic\SmsBundle\Entity\Sms #}
{% set type            = sms.getSmsType() %}
{% set isExisting      = sms.getId() %}
{% set translationBase = 'mautic.sms' %}
{% set mauticContent   = 'sms' %}

{% block primaryFormContent %}
<div class="row">
    <div class="col-md-6">
        {{ form_row(form.name) }}
    </div>
    {# NOVO CAMPO: Seletor de Estratégia de Disparo #}
    <div class="col-md-6">
        {{ form_row(form.tipo_disparo) }}
    </div>
</div>

<div class="row">
    {# NOVO CAMPO: Remetente / Dono #}
    <div class="col-md-6">
        {{ form_row(form.ui_remetente) }}
    </div>
    {# NOVO CAMPO: Template (Aparece apenas quando Typebot é selecionado) #}
    <div class="col-md-6">
        {{ form_row(form.ui_template) }}
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="characters-count">
            <label class="control-label" for="" data-toggle="tooltip" data-container="body" data-placement="top" title="" data-original-title="{{ 'mautic.sms.form.nbcharacter.infobox'|trans }}">
                {{ 'mautic.sms.form.nbcharacter.counter'|trans }}
                <span size="sm" class="label label-gray" id="sms_nb_char">0</span>
            </label>
        </div>
        
        {# NOVO CAMPO: Mensagem (Aparece apenas quando Texto/SMS é selecionado) #}
        {{ form_row(form.ui_mensagem) }}
        
        {# CAMPO ORIGINAL (Oculto pela classe/id no SmsType, mas obrigatório para o Mautic salvar) #}
        {{ form_row(form.message) }}
        
        <i class="text-secondary">{{ 'mautic.sms.token.dropdown.hint'|trans|purify }}</i>

    </div>
</div>
{% endblock %}

{% block rightFormContent %}
{{ form_row(form.category) }}
{{ form_row(form.projects) }}
{{ form_row(form.language) }}
{{ form_row(form.translationParentSelector) }}
{{ form_row(form.isPublished, {
    'attr': {
        'data-none': 'mautic.core.form.sending_paused',
        'data-start': 'mautic.core.form.sending_on_scheduled_start',
        'data-both': 'mautic.core.form.sending_during_scheduled_period',
        'data-end': 'mautic.core.form.available_until_scheduled_end'
    }
}) }}

<div id="leadList"{% if 'template' == type %} class="hide"{% endif %}>
    {{ form_row(form.lists) }}
    {{ form_row(form.publishUp, {'label': 'mautic.core.form.sending.start_at'}) }}
    {{ form_row(form.publishDown, {'label': 'mautic.core.form.sending.stop_at'}) }}
</div>

<div class="hide">
    {{ form_rest(form) }}
</div>

{% if (updateSelect is not defined or updateSelect is empty) and not isExisting and not formContainsErrors(form) or type is empty %}
    {{- include('@MauticCore/Helper/form_selecttype.html.twig',
        {
            'item'       : sms,
            'mauticLang' : {
                'newListSms'     : 'mautic.sms.type.list.header',
                'newTemplateSms' : 'mautic.sms.type.template.header',
            },
            'typePrefix'         : 'sms',
            'cancelUrl'          : 'mautic_sms_index',
            'header'             : 'mautic.sms.type.header',
            'typeOneHeader'      : 'mautic.sms.type.template.header',
            'typeOnePictogram': 'process--automation',
            'typeOneTag'         : 'mautic.sms.type.template.tag',
            'typeOneDifferences' : ['mautic.sms.type.template.differences.1st', 'mautic.sms.type.template.differences.2nd', 'mautic.sms.type.template.differences.3rd', 'mautic.sms.type.template.differences.4th', 'mautic.sms.type.template.differences.5th'],
            'typeOneOnClick'     : "Mautic.selectSmsType('template');",
            'typeTwoHeader'      : 'mautic.sms.type.list.header',
            'typeTwoTag'         : 'mautic.sms.type.list.tag',
            'typeTwoPictogram': 'chart--pie',
            'typeTwoDifferences' : ['mautic.sms.type.list.differences.1st', 'mautic.sms.type.list.differences.2nd', 'mautic.sms.type.list.differences.3rd', 'mautic.sms.type.list.differences.4th', 'mautic.sms.type.list.differences.5th'],
            'typeTwoOnClick'     : "Mautic.selectSmsType('list');",
        }
    ) -}}
{% endif %}
{% endblock %}

{# ========================================================================= #}
{# SCRIPT DE CONTROLE DINÂMICO DA INTERFACE (MNO WHATSAPP SETUP)             #}
{# ========================================================================= #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Aguarda um pequeno delay para garantir que o Symfony/Mautic renderizou o modal
    setTimeout(function() {
        const seletorTipo = document.getElementById('tipo_disparo_selector');
        const boxTemplate = document.getElementById('ui_template_field') ? document.getElementById('ui_template_field').closest('div.form-group') : null;
        const boxMensagem = document.getElementById('ui_mensagem_field') ? document.getElementById('ui_mensagem_field').closest('div.form-group') : null;
        const campoOcultoPayload = document.getElementById('mensagem_original_oculta');

        if (!seletorTipo || !campoOcultoPayload) return; // Evita erros se a aba não estiver carregada

        // 1. Função para esconder/mostrar campos baseado na escolha
        function atualizarCamposVisiveis() {
            const tipo = seletorTipo.value;
            if (tipo.includes('typebot')) {
                if (boxTemplate) boxTemplate.style.display = 'block';
                if (boxMensagem) boxMensagem.style.display = 'none';
            } else {
                if (boxTemplate) boxTemplate.style.display = 'none';
                if (boxMensagem) boxMensagem.style.display = 'block';
            }
        }

        // 2. Função de Engenharia Reversa (Para edição de campanhas já salvas)
        function carregarDadosExistentes() {
            const payloadAtual = campoOcultoPayload.value;
            if (!payloadAtual) return;

            // Extrai o remetente comum a todos
            const matchRemetente = payloadAtual.match(/remetente:\s*(.*)/);
            if (matchRemetente && document.getElementById('ui_remetente_field')) {
                document.getElementById('ui_remetente_field').value = matchRemetente[1].trim();
            }

            // Detecta qual tipo de payload foi salvo no banco e preenche a UI
            if (payloadAtual.includes('template_oficial:')) {
                seletorTipo.value = 'wa_oficial_typebot';
                const m = payloadAtual.match(/template_oficial:\s*(.*)/);
                if(m && document.getElementById('ui_template_field')) document.getElementById('ui_template_field').value = m[1].trim();

            } else if (payloadAtual.includes('template:')) {
                seletorTipo.value = 'wa_nao_oficial_typebot';
                const m = payloadAtual.match(/template:\s*(.*)/);
                if(m && document.getElementById('ui_template_field')) document.getElementById('ui_template_field').value = m[1].trim();

            } else if (payloadAtual.includes('mensagem_whatsapp:')) {
                seletorTipo.value = 'wa_nao_oficial_texto';
                const m = payloadAtual.match(/mensagem_whatsapp:\s*(.*?)\nnumber:/s);
                if(m && document.getElementById('ui_mensagem_field')) document.getElementById('ui_mensagem_field').value = m[1].trim();

            } else if (payloadAtual.includes('mensagem_sms:')) {
                seletorTipo.value = 'sms_simples';
                const m = payloadAtual.match(/mensagem_sms:\s*(.*?)\nnumber:/s);
                if(m && document.getElementById('ui_mensagem_field')) document.getElementById('ui_mensagem_field').value = m[1].trim();
            }
        }

        // Executa ao carregar a interface
        carregarDadosExistentes();
        atualizarCamposVisiveis();

        // Fica ouvindo as mudanças no dropdown
        seletorTipo.addEventListener('change', atualizarCamposVisiveis);
        
    }, 500); // 500ms de delay de segurança
});
</script>
